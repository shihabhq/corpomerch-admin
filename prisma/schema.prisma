// CorpoMerch — canonical database schema.
//
// This file is OWNED BY corpomerch-admin. The storefront keeps a byte-identical
// copy (via `npm run sync:schema`) purely to generate its read client, and must
// never run a migration.
//
// Invariants that live in application code rather than the DSL are documented in
// CLAUDE.md §4. The short version:
//   * price lives on a Sku, never on a Product
//   * every Product has >= 1 Sku (option-less products get one `isDefault` Sku)
//   * only ProductOption.position == 1 may carry images
//   * money and quantity are Decimal(12,2) — never Float, never Int

// Prisma 7: connection URLs live in prisma.config.ts, not here.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingMode {
  TIERED
  ON_REQUEST
}

/// Unit of sale. Banners and backdrops are sold per SQFT and may be fractional,
/// which is why every quantity column in this schema is Decimal, not Int.
enum UnitKind {
  PC
  SET
  SQFT
  PAIR
  BOX
  SHEET
}

enum OptionDisplay {
  CHIP
  SWATCH
  DROPDOWN
  IMAGE
}

enum InquirySource {
  PRODUCT
  CART
  CONTACT
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
  SPAM
}

enum AdminRole {
  ADMIN
  EDITOR
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────────────────────

/// Two levels maximum (enforced in the admin UI + a DB trigger).
model Category {
  id       String  @id @default(uuid()) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid

  slug        String  @unique
  name        String
  description String?
  /// lucide-react icon name, used by the storefront nav and category tiles
  iconKey     String? @map("icon_key")
  imagePath   String? @map("image_path")

  sortOrder Int           @default(0) @map("sort_order")
  status    PublishStatus @default(PUBLISHED)

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId, sortOrder])
  @@index([status])
  @@map("categories")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  /// Exactly one primary category per product — drives breadcrumbs and the
  /// canonical URL. A partial unique index enforces this (see migration).
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("product_categories")
}

model Product {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  name     String
  subtitle String?

  /// Card / meta description. Required to publish.
  shortDescription String? @map("short_description")
  /// Long-form markdown. Required to publish.
  description      String?

  /// Ordered array of { group?, key, value }. NOT an object — key order is
  /// meaningful and duplicate keys must not collapse.
  specs Json     @default("[]")
  tags  String[] @default([])

  unit      UnitKind @default(PC)
  /// Display override, e.g. "sq.ft." for SQFT
  unitLabel String?  @map("unit_label")
  qtyStep   Decimal  @default(1) @map("qty_step") @db.Decimal(12, 2)
  /// Product-level minimum order quantity; a Sku may override it.
  moq       Decimal? @db.Decimal(12, 2)

  pricingMode PricingMode @default(TIERED) @map("pricing_mode")
  currency    String      @default("BDT") @db.Char(3)

  leadTimeDaysMin Int? @map("lead_time_days_min")
  leadTimeDaysMax Int? @map("lead_time_days_max")

  isFeatured Boolean @default(false) @map("is_featured")
  badgeText  String? @map("badge_text")

  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  sortOrder   Int           @default(0) @map("sort_order")

  primaryImageId String? @unique @map("primary_image_id") @db.Uuid

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  /// Denormalised pricing summary, recomputed by recomputeProductPricing()
  /// after ANY change to skus, tiers, moq or pricingMode. The storefront's
  /// listing pages read these directly instead of aggregating tiers per request.
  minUnitPrice Decimal? @map("min_unit_price") @db.Decimal(12, 2)
  maxUnitPrice Decimal? @map("max_unit_price") @db.Decimal(12, 2)
  effectiveMoq Decimal? @map("effective_moq") @db.Decimal(12, 2)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories   ProductCategory[]
  options      ProductOption[]
  skus         Sku[]
  images       ProductImage[]     @relation("ProductImages")
  primaryImage ProductImage?      @relation("ProductPrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
  inquiryItems InquiryItem[]
  portfolio    PortfolioProduct[]

  @@index([status, sortOrder])
  @@index([isFeatured, sortOrder])
  @@index([minUnitPrice])
  @@map("products")
}

/// A variant axis. Position 1 is special: it is the only axis whose values may
/// carry images, and selecting a value on it swaps the storefront gallery.
model ProductOption {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// 1..3, enforced by a check constraint in the migration.
  position  Int
  name      String
  helpText  String?       @map("help_text")
  displayAs OptionDisplay @default(CHIP) @map("display_as")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]
  skuLink SkuOptionValue[]

  @@unique([productId, position])
  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(uuid()) @db.Uuid
  optionId String @map("option_id") @db.Uuid

  label String
  /// Stable, URL-safe key used in the storefront query string (?material=wood)
  valueCode   String  @map("value_code")
  /// Rendered when displayAs == SWATCH and there is no photo to show
  swatchHex   String? @map("swatch_hex")
  description String?

  sortOrder Int     @default(0) @map("sort_order")
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  option ProductOption    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  images ProductImage[]
  skus   SkuOptionValue[]

  @@unique([optionId, valueCode])
  @@index([optionId, sortOrder])
  @@map("product_option_values")
}

/// One purchasable combination of option values, and the thing that owns price.
/// A product with no options still has exactly one Sku, with isDefault = true
/// and zero SkuOptionValue rows — so consumers never branch on "has variants".
model Sku {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  skuCode   String? @unique @map("sku_code")
  /// Human label composed from the chosen values, e.g. "Wood / 2 cm"
  label     String?

  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  /// This specific combination has no published price (e.g. the steel bottle
  /// alongside a priced plastic one). Distinct from Product.pricingMode.
  priceOnRequest Boolean  @default(false) @map("price_on_request")
  /// Overrides Product.moq for this combination.
  moq            Decimal? @db.Decimal(12, 2)

  /// Ordered, comma-joined list of chosen optionValueIds. Computed in TypeScript
  /// by buildOptionSignature(); paired with the unique index below it is what
  /// makes "Generate SKUs" idempotent. Empty string for the default Sku.
  optionSignature String @default("") @map("option_signature")

  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues SkuOptionValue[]
  priceTiers   PriceTier[]
  inquiryItems InquiryItem[]

  @@unique([productId, optionSignature])
  @@index([productId, sortOrder])
  @@map("skus")
}

model SkuOptionValue {
  skuId         String @map("sku_id") @db.Uuid
  optionId      String @map("option_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  sku         Sku                @relation(fields: [skuId], references: [id], onDelete: Cascade)
  option      ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  /// One value per axis per sku.
  @@id([skuId, optionId])
  @@unique([skuId, optionValueId])
  @@index([optionValueId])
  @@map("sku_option_values")
}

/// A quantity break. minQty is an inclusive, OPEN-ENDED minimum: the upper bound
/// is the next tier's minQty minus one step. [{50,15},{100,12}] reads as
/// "50-99 -> 15, 100+ -> 12". Never store or render an explicit upper bound.
model PriceTier {
  id    String @id @default(uuid()) @db.Uuid
  skuId String @map("sku_id") @db.Uuid

  minQty         Decimal  @map("min_qty") @db.Decimal(12, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  /// Optional struck-through "was" price for promotional display.
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  note           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, minQty])
  @@index([skuId, minQty])
  @@map("price_tiers")
}

/// optionValueId NULL  => shared gallery, shown for every variant
/// optionValueId set   => scoped to that axis-1 value, swapped in when selected
model ProductImage {
  id            String  @id @default(uuid()) @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  optionValueId String? @map("option_value_id") @db.Uuid

  /// Path inside the Supabase bucket. Public URLs are built by lib/storage.ts so
  /// the bucket host can change without a data migration.
  storagePath String? @map("storage_path")
  /// Escape hatch for images that live outside Storage.
  externalUrl String? @map("external_url")

  alt         String
  width       Int?
  height      Int?
  /// Pre-generated base64 for next/image placeholder="blur"
  blurDataUrl String? @map("blur_data_url")

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      Product             @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)
  optionValue  ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  primaryOf    Product?            @relation("ProductPrimaryImage")

  @@index([productId, optionValueId, sortOrder])
  @@map("product_images")
}

// ─────────────────────────────────────────────────────────────────────────────
// Inquiries — the only thing a storefront visitor can write
// ─────────────────────────────────────────────────────────────────────────────

model Inquiry {
  id  String @id @default(uuid()) @db.Uuid
  /// Short human reference echoed into the WhatsApp message, e.g. "CM-7Q2K"
  ref String @unique

  source InquirySource

  name    String?
  company String?
  phone   String?
  email   String?
  message String?

  /// Sum of the priced lines at submission time. Excludes price-on-request lines.
  totalEstimate Decimal? @map("total_estimate") @db.Decimal(12, 2)
  currency      String   @default("BDT") @db.Char(3)

  status       InquiryStatus @default(NEW)
  assignedTo   String?       @map("assigned_to") @db.Uuid
  internalNote String?       @map("internal_note")

  userAgent String? @map("user_agent")
  referer   String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items    InquiryItem[]
  assignee AdminUser?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("inquiries")
}

/// Snapshot columns freeze the quote. Without them, editing a price next month
/// silently rewrites last month's inquiries.
model InquiryItem {
  id        String @id @default(uuid()) @db.Uuid
  inquiryId String @map("inquiry_id") @db.Uuid

  productId String? @map("product_id") @db.Uuid
  skuId     String? @map("sku_id") @db.Uuid

  quantity  Decimal  @db.Decimal(12, 2)
  unitPrice Decimal? @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal? @map("line_total") @db.Decimal(12, 2)
  note      String?

  productNameSnapshot String   @map("product_name_snapshot")
  productSlugSnapshot String   @map("product_slug_snapshot")
  /// [{ option: "Material", value: "Wood" }, ...]
  optionsSnapshot     Json     @default("[]") @map("options_snapshot")
  unitSnapshot        UnitKind @map("unit_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inquiry Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku     Sku?     @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@index([productId])
  @@map("inquiry_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin
// ─────────────────────────────────────────────────────────────────────────────

/// Mirrors auth.users. A valid Supabase session is NOT sufficient authorisation —
/// requireAdmin() also demands an active row here.
model AdminUser {
  id       String    @id @db.Uuid
  email    String    @unique
  fullName String?   @map("full_name")
  role     AdminRole @default(ADMIN)
  isActive Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedInquiries Inquiry[]

  @@map("admin_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Site content
// ─────────────────────────────────────────────────────────────────────────────

model Partner {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  logoPath String? @map("logo_path")
  website  String?

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("partners")
}

model PortfolioItem {
  id      String @id @default(uuid()) @db.Uuid
  slug    String @unique
  title   String
  client  String?
  /// e.g. "Career Fair", "Annual Conference"
  eventType String? @map("event_type")

  summary     String?
  description String?
  eventDate   DateTime? @map("event_date") @db.Date

  coverPath String?  @map("cover_path")
  gallery   Json     @default("[]")

  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0) @map("sort_order")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products PortfolioProduct[]

  @@index([status, sortOrder])
  @@map("portfolio_items")
}

model PortfolioProduct {
  portfolioItemId String @map("portfolio_item_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  sortOrder       Int    @default(0) @map("sort_order")

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([portfolioItemId, productId])
  @@map("portfolio_products")
}

model HomepageBanner {
  id       String  @id @default(uuid()) @db.Uuid
  title    String
  subtitle String?
  ctaLabel String? @map("cta_label")
  ctaHref  String? @map("cta_href")

  imagePath       String  @map("image_path")
  mobileImagePath String? @map("mobile_image_path")
  alt             String

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("homepage_banners")
}

model Testimonial {
  id         String  @id @default(uuid()) @db.Uuid
  quote      String
  authorName String  @map("author_name")
  authorRole String? @map("author_role")
  company    String?
  avatarPath String? @map("avatar_path")
  rating     Int?

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("testimonials")
}

model Faq {
  id       String  @id @default(uuid()) @db.Uuid
  question String
  answer   String
  /// "ordering" | "printing" | "delivery" | "payment"
  category String?

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, category, sortOrder])
  @@map("faqs")
}

/// Singleton. Always read/written with id = 1.
model SiteSetting {
  id Int @id @default(1)

  whatsappNumber String @map("whatsapp_number")
  contactEmail   String @map("contact_email")
  contactPhone   String @map("contact_phone")
  addressLine    String @map("address_line")
  addressCity    String @map("address_city")
  mapUrl         String? @map("map_url")

  facebookUrl  String? @map("facebook_url")
  instagramUrl String? @map("instagram_url")
  linkedinUrl  String? @map("linkedin_url")

  defaultSeoTitle       String? @map("default_seo_title")
  defaultSeoDescription String? @map("default_seo_description")
  announcementText      String? @map("announcement_text")
  announcementActive    Boolean @default(false) @map("announcement_active")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}
